rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         request.auth.token.email == "francimario89@gmail.com");
    }

    // User profiles
    match /users/{userId} {
      // Permitir que qualquer um consulte por telefone para o fluxo de login/cadastro
      // Nota: Em produção real, isso deve ser limitado ou movido para Cloud Functions
      allow read: if true; 
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
    }

    // Establishments
    match /establishments/{estId} {
      allow read: if true;
      allow create, delete: if isAdmin() || (isAuthenticated() && resource.data.ownerEmail == request.auth.token.email);
      allow update: if isAdmin() || 
                    (isAuthenticated() && (
                      resource.data.ownerEmail == request.auth.token.email || 
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nextCodeNumber'])
                    ));
      
      // Subcollections
      match /queue/{itemId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated(); // Simplificado para o protótipo
      }
      
      match /services/{serviceId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
      
      match /professionals/{proId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
      
      match /revenue/{revId} {
        allow read, write: if isAuthenticated();
      }
    }
  }
}
